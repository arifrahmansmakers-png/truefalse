<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Game Kuis Kanan vs Kiri - Integrasi Google Sheets</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Animate.css untuk Animasi Pop-Up -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

  <!-- Google MediaPipe Face Mesh Libraries -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" crossorigin="anonymous"></script>
</head>
<body class="bg-slate-900 text-white font-sans min-h-screen flex flex-col items-center justify-center p-4 selection:bg-emerald-500 selection:text-black">

  <!-- Container Utama -->
  <div class="relative w-full max-w-4xl bg-slate-800 rounded-2xl shadow-2xl overflow-hidden border border-slate-700">
    
    <!-- Tampilan Kamera & Canvas (Layar Terbagi 2) -->
    <div class="relative w-full h-[480px] bg-black flex items-center justify-center overflow-hidden">
      <!-- Video Input (Mirror) -->
      <video id="webcam" class="absolute w-full h-full object-cover scale-x-[-1]" playsinline></video>
      <canvas id="output_canvas" class="absolute w-full h-full object-cover scale-x-[-1]"></canvas>

      <!-- Overlay Pop-up Hasil Evaluasi (Benar / Salah) -->
      <div id="popup-evaluasi" class="hidden absolute z-30 flex flex-col items-center justify-center p-6 bg-slate-900/90 rounded-3xl border-2 shadow-2xl backdrop-blur-md">
        <div id="popup-emoji" class="text-7xl mb-2">🎉</div>
        <div id="popup-title" class="text-4xl font-extrabold tracking-wide mb-1">BENAR!</div>
        <div id="popup-subtitle" class="text-lg font-semibold text-slate-300">+10 Poin</div>
      </div>

      <!-- Zone Kiri (50% Layar) -->
      <div id="zone-kiri" class="absolute left-0 top-0 w-1/2 h-full bg-blue-500/20 border-r-2 border-white/20 flex flex-col items-center justify-center transition-all duration-300">
        <span class="text-4xl font-black text-blue-400 drop-shadow-lg tracking-wider">KIRI</span>
      </div>

      <!-- Zone Kanan (50% Layar) -->
      <div id="zone-kanan" class="absolute right-0 top-0 w-1/2 h-full bg-emerald-500/20 border-l-2 border-white/20 flex flex-col items-center justify-center transition-all duration-300">
        <span class="text-4xl font-black text-emerald-400 drop-shadow-lg tracking-wider">KANAN</span>
      </div>

      <!-- Status Pilihan Pemain Real-time -->
      <div id="status-jawaban" class="absolute bottom-6 bg-slate-900/90 text-white px-6 py-2 rounded-full font-bold text-lg border border-slate-600 shadow-lg z-10">
        Pilihan Kamu: <span id="pilihan-text" class="text-yellow-400">TENGAH</span>
      </div>
    </div>

    <!-- Panel Soal & Kontrol Game -->
    <div class="p-6 bg-slate-800 flex flex-col items-center text-center">
      <!-- Informasi Ronde & Timer -->
      <div class="flex justify-between w-full mb-4 text-sm font-semibold text-slate-400">
        <span id="soal-index">Soal 0 dari 0</span>
        <span id="timer-text" class="text-yellow-400 text-base">Sisa Waktu: --</span>
        <span id="skor-text">Skor: 0</span>
      </div>

      <!-- Teks Pertanyaan -->
      <div id="soal-container" class="min-h-[80px] flex items-center justify-center mb-6">
        <h2 id="pertanyaan" class="text-2xl font-bold text-white">Memuat Soal dari Google Sheets...</h2>
      </div>

      <!-- Kartu Opsi Jawaban -->
      <div class="grid grid-cols-2 gap-4 w-full mb-6">
        <div id="card-kiri" class="p-4 bg-blue-950/60 border-2 border-blue-500 rounded-xl transition-all">
          <div class="text-xs text-blue-400 font-bold mb-1">PILIHAN KIRI</div>
          <div id="jawaban-kiri" class="text-lg font-semibold text-blue-200">-</div>
        </div>
        <div id="card-kanan" class="p-4 bg-emerald-950/60 border-2 border-emerald-500 rounded-xl transition-all">
          <div class="text-xs text-emerald-400 font-bold mb-1">PILIHAN KANAN</div>
          <div id="jawaban-kanan" class="text-lg font-semibold text-emerald-200">-</div>
        </div>
      </div>

      <!-- Tombol Kontrol -->
      <button id="btn-start" onclick="mulaiGame()" disabled class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed">
        Mulai Game
      </button>
    </div>
  </div>

  <script>
    // =========================================================================
    // TEMPAT MENARUH LINK CSV GOOGLE SHEETS
    // =========================================================================
    // Salin link CSV dari Google Sheets (File > Share > Publish to Web > CSV)
    const GOOGLE_SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vTChgAcjMHAYhF-bblNpuBKQVcCpDFkpHQ9mDHm_OoAejCBQZyVu9IqSs5Fg9FwPcb6lU9HvCyD2ZCm/pub?output=csv";

    // Data Soal Global
    let daftarSoal = [];
    let currentSoalIndex = 0;
    let skor = 0;
    let sisaWaktu = 5;
    let timerInterval = null;
    let pilihanPemain = "tengah";
    let gameBerjalan = false;
    let sedangEvaluasi = false;
    let kameraSiap = false;

    // Element DOM
    const videoElement = document.getElementById('webcam');
    const canvasElement = document.getElementById('output_canvas');
    const canvasCtx = canvasElement.getContext('2d');
    const btnStart = document.getElementById('btn-start');
    const zoneKiri = document.getElementById('zone-kiri');
    const zoneKanan = document.getElementById('zone-kanan');
    const popupEvaluasi = document.getElementById('popup-evaluasi');

    // Web Audio API untuk Efek Suara
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playSoundSuccess() {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const notes = [523.25, 659.25, 783.99, 1046.50]; // Arpeggio C Major (C5, E5, G5, C6)
      notes.forEach((freq, i) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.15, audioCtx.currentTime + i * 0.08);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + i * 0.08 + 0.25);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(audioCtx.currentTime + i * 0.08);
        osc.stop(audioCtx.currentTime + i * 0.08 + 0.25);
      });
    }

    function playSoundWrong() {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(180, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(70, audioCtx.currentTime + 0.4);
      gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.4);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.4);
    }

    function playSoundTick() {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(600, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.05);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.05);
    }

    // =========================================================================
    // FUNGSI MEMUAT DATA DARI GOOGLE SHEETS (CSV PARSER)
    // =========================================================================
    async function muatSoalDariGoogleSheets() {
      try {
        const response = await fetch(GOOGLE_SHEET_CSV_URL);
        if (!response.ok) throw new Error("Gagal mengunduh file CSV.");
        const textData = await response.text();

        // Regex CSV Parser untuk menangani koma di dalam tanda kutip
        const rows = textData.trim().split(/\r?\n/);
        const hasilSoal = [];

        for (let i = 1; i < rows.length; i++) {
          if (!rows[i].trim()) continue;
          
          // Memisah baris CSV berdasarkan koma
          const cols = rows[i].match(/(".*?"|[^",\s]+)(?=\s*,|\s*$)/g) || rows[i].split(',');
          const cleanCols = cols.map(c => c.replace(/^"|"$/g, '').trim());

          if (cleanCols.length >= 4) {
            hasilSoal.push({
              pertanyaan: cleanCols[0],
              kiri: cleanCols[1],
              kanan: cleanCols[2],
              jawabanBenar: cleanCols[3].toLowerCase() // 'kiri' atau 'kanan'
            });
          }
        }

        daftarSoal = hasilSoal;

        if (daftarSoal.length > 0) {
          if (kameraSiap) {
            document.getElementById('pertanyaan').innerText = "Siap! Tekan 'Mulai Game'.";
            btnStart.disabled = false;
          } else {
            document.getElementById('pertanyaan').innerText = "Soal dimuat! Menunggu kamera...";
          }
        } else {
          document.getElementById('pertanyaan').innerText = "Soal kosong! Cek isi Google Sheets.";
        }
      } catch (err) {
        console.error(err);
        document.getElementById('pertanyaan').innerText = "Gagal mengambil soal dari Google Sheets!";
      }
    }

    // =========================================================================
    // MEDIAPIPE FACE MESH SETUP
    // =========================================================================
    const faceMesh = new FaceMesh({
      locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/${file}`
    });

    faceMesh.setOptions({
      maxNumFaces: 1,
      refineLandmarks: true,
      minDetectionConfidence: 0.5,
      minTrackingConfidence: 0.5
    });

    faceMesh.onResults(onResults);

    const camera = new Camera(videoElement, {
      onFrame: async () => {
        await faceMesh.send({ image: videoElement });
      },
      width: 640,
      height: 480
    });
    camera.start();

    function onResults(results) {
      canvasCtx.save();
      canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

      if (results.multiFaceLandmarks && results.multiFaceLandmarks.length > 0) {
        const landmarks = results.multiFaceLandmarks[0];
        const noseX = landmarks[1].x; // Koordinat X hidung (0.0 - 1.0)

        if (!kameraSiap) {
          kameraSiap = true;
          if (daftarSoal.length > 0 && !gameBerjalan) {
            document.getElementById('pertanyaan').innerText = "Kamera Siap! Tekan 'Mulai Game'.";
            btnStart.disabled = false;
          }
        }

        // Posisi Kepala (Mirror Input)
        if (!sedangEvaluasi) {
          if (noseX > 0.53) {
            pilihanPemain = "kiri";
            updatePilihanUI("KIRI");
          } else if (noseX < 0.47) {
            pilihanPemain = "kanan";
            updatePilihanUI("KANAN");
          } else {
            pilihanPemain = "tengah";
            updatePilihanUI("TENGAH");
          }
        }
      } else {
        if (!sedangEvaluasi) {
          pilihanPemain = "tengah";
          updatePilihanUI("TIDAK TERDETEKSI");
        }
      }
      canvasCtx.restore();
    }

    function updatePilihanUI(text) {
      document.getElementById('pilihan-text').innerText = text;

      zoneKiri.className = "absolute left-0 top-0 w-1/2 h-full border-r-2 border-white/20 flex flex-col items-center justify-center transition-all duration-300 " + 
        (pilihanPemain === "kiri" ? "bg-blue-500/50 ring-4 ring-blue-400 inset-0" : "bg-blue-500/20");
        
      zoneKanan.className = "absolute right-0 top-0 w-1/2 h-full border-l-2 border-white/20 flex flex-col items-center justify-center transition-all duration-300 " + 
        (pilihanPemain === "kanan" ? "bg-emerald-500/50 ring-4 ring-emerald-400 inset-0" : "bg-emerald-500/20");
    }

    // =========================================================================
    // FLOW KONTROL GAME
    // =========================================================================
    function mulaiGame() {
      if (daftarSoal.length === 0) return;
      currentSoalIndex = 0;
      skor = 0;
      gameBerjalan = true;
      sedangEvaluasi = false;
      btnStart.classList.add('hidden');
      document.getElementById('skor-text').innerText = `Skor: ${skor}`;
      tampilkanSoal();
    }

    function tampilkanSoal() {
      if (currentSoalIndex >= daftarSoal.length) {
        selesaiGame();
        return;
      }

      sedangEvaluasi = false;
      popupEvaluasi.classList.add('hidden');
      popupEvaluasi.className = "hidden absolute z-30 flex flex-col items-center justify-center p-6 bg-slate-900/90 rounded-3xl border-2 shadow-2xl backdrop-blur-md";

      updatePilihanUI("TENGAH");

      const soal = daftarSoal[currentSoalIndex];
      document.getElementById('soal-index').innerText = `Soal ${currentSoalIndex + 1} dari ${daftarSoal.length}`;
      document.getElementById('pertanyaan').innerText = soal.pertanyaan;
      document.getElementById('jawaban-kiri').innerText = soal.kiri;
      document.getElementById('jawaban-kanan').innerText = soal.kanan;

      sisaWaktu = 5;
      document.getElementById('timer-text').innerText = `Sisa Waktu: ${sisaWaktu}s`;

      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        sisaWaktu--;
        document.getElementById('timer-text').innerText = `Sisa Waktu: ${sisaWaktu}s`;
        
        if (sisaWaktu <= 3 && sisaWaktu > 0) playSoundTick();

        if (sisaWaktu <= 0) {
          clearInterval(timerInterval);
          evaluasiJawaban();
        }
      }, 1000);
    }

    function evaluasiJawaban() {
      sedangEvaluasi = true;
      const soal = daftarSoal[currentSoalIndex];
      const jawabanBenar = soal.jawabanBenar;

      // Layar Terbagi 2 (Hijau untuk Benar, Merah untuk Salah)
      if (jawabanBenar === "kiri") {
        zoneKiri.className = "absolute left-0 top-0 w-1/2 h-full bg-green-500/70 flex flex-col items-center justify-center transition-all duration-300 border-4 border-green-400 z-10";
        zoneKanan.className = "absolute right-0 top-0 w-1/2 h-full bg-red-500/70 flex flex-col items-center justify-center transition-all duration-300 border-4 border-red-400 z-10";
      } else {
        zoneKiri.className = "absolute left-0 top-0 w-1/2 h-full bg-red-500/70 flex flex-col items-center justify-center transition-all duration-300 border-4 border-red-400 z-10";
        zoneKanan.className = "absolute right-0 top-0 w-1/2 h-full bg-green-500/70 flex flex-col items-center justify-center transition-all duration-300 border-4 border-green-400 z-10";
      }

      // Animasi Pop-Up Evaluasi
      const isCorrect = (pilihanPemain === jawabanBenar);
      
      if (isCorrect) {
        skor += 10;
        playSoundSuccess();
        document.getElementById('popup-emoji').innerText = "🎉";
        document.getElementById('popup-title').innerText = "BENAR!";
        document.getElementById('popup-title').className = "text-4xl font-extrabold tracking-wide mb-1 text-emerald-400";
        document.getElementById('popup-subtitle').innerText = "+10 Poin Tambahan";
        popupEvaluasi.classList.add('border-emerald-500', 'animate__animated', 'animate__bounceIn');
      } else {
        playSoundWrong();
        document.getElementById('popup-emoji').innerText = "❌";
        document.getElementById('popup-title').innerText = "SALAH!";
        document.getElementById('popup-title').className = "text-4xl font-extrabold tracking-wide mb-1 text-red-500";
        document.getElementById('popup-subtitle').innerText = `Jawaban Benar: ${jawabanBenar.toUpperCase()}`;
        popupEvaluasi.classList.add('border-red-500', 'animate__animated', 'animate__shakeX');
      }

      popupEvaluasi.classList.remove('hidden');
      document.getElementById('skor-text').innerText = `Skor: ${skor}`;

      // Jeda 2.5 detik sebelum soal berikutnya
      setTimeout(() => {
        currentSoalIndex++;
        tampilkanSoal();
      }, 2500);
    }

    function selesaiGame() {
      gameBerjalan = false;
      sedangEvaluasi = false;
      popupEvaluasi.classList.add('hidden');
      document.getElementById('pertanyaan').innerHTML = `Game Selesai! Total Skor: <span class="text-yellow-400 text-3xl">${skor}</span>`;
      document.getElementById('jawaban-kiri').innerText = "-";
      document.getElementById('jawaban-kanan').innerText = "-";
      btnStart.innerText = "Main Lagi";
      btnStart.classList.remove('hidden');
      btnStart.disabled = false;
    }

    // Jalankan pengambilan soal saat halaman pertama dibuka
    muatSoalDariGoogleSheets();
  </script>
</body>
</html>

